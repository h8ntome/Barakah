# Docker Compose LOCAL development only. Generate URL-safe values; never commit .env.
# python3 -c 'import secrets; print(secrets.token_hex(32))'
POSTGRES_PASSWORD=replace-with-random-hex
SECRET_KEY=replace-with-a-different-random-hex-at-least-32-characters
# Backend non-Docker configuration lives in backend/.env.example.
# Production requires HTTPS, secure cookies, a private database and explicit trusted origins.
