DATABASE_URL=sqlite:///./barakah.db
# PostgreSQL: postgresql+psycopg://barakah:change-me@localhost:5432/barakah
ENVIRONMENT=development
SECRET_KEY=development-only-change-this-secret-before-deployment
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
COOKIE_SECURE=false
# Default makes no model calls and saves no failed sends. Opt-in: docs/local-ai.md.
AI_MODE=unavailable
# AI_MODE=http requires a private loopback endpoint (or SSH tunnel) and saved user consent.
# AI_URL=http://127.0.0.1:8765/generate
# AI_TOKEN=<random URL-safe secret of at least 32 characters; same as local service>
AI_TIMEOUT_SECONDS=90
# Development-only, private token delivery files; never serve this directory:
# RESET_OUTBOX=./outbox
AUTH_RATE_LIMIT=20
ADVISOR_RATE_LIMIT=30
# Production reset email uses authenticated, certificate-verified STARTTLS:
# SMTP_HOST=smtp.example.com
SMTP_PORT=587
# SMTP_USERNAME=...
# SMTP_PASSWORD=...
SMTP_SENDER=noreply@example.com
RESET_URL=http://localhost:5173/reset-password
